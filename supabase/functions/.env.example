# Provider selection — the single swap point. No app code changes to switch.
AI_PROVIDER=mock          # anthropic | openai | mock

# Keys (only the selected provider's key is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (defaults shown)
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-5
