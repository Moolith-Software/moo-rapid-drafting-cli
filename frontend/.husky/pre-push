# Formatting, lint, types and dead code for the backend.
#
# Runs against the working tree, not against the commits being pushed.
#
# uv builds the backend venv from uv.lock on first run, so this works in a
# fresh clone or a worktree that has no .venv yet.

if ! command -v uv > /dev/null 2>&1; then
  echo "pre-push: uv not on PATH - install it or push with --no-verify" >&2
  exit 1
fi

# Not assuming the directory git happens to run hooks from.
cd "$(git rev-parse --show-toplevel)" || exit 1
npm --prefix frontend run check:backend
