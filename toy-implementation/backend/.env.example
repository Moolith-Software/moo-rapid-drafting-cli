# Copy this to `.env` and fill in your key. Never commit the real .env.

OPENAI_API_KEY=sk-...

# Which provider to use. Defaults to "codex_sdk" - a missing key fails loudly rather
# than silently producing fake results. Set to "mock" to run offline and free.
# AI_PROVIDER=mock

# production by default, set to development for your local machine to see docs/openAPI
# ENV=development
