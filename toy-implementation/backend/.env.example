# Copy this to `.env` and fill in your key. Never commit the real .env.

OPENAI_API_KEY=sk-...

# Which provider to use. Defaults to "codex" — a missing key fails loudly rather
# than silently producing fake results. Set to "mock" to run offline and free.
# AI_PROVIDER=mock

# Shared by every provider. Leave unset for the provider's own defaults.
# AI_MODEL=gpt-5-codex
# AI_TIMEOUT_SECONDS=1200

# Mock only: make it raise a timeout, to exercise that path offline.
# MOCK_TIMEOUT=1
